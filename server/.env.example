PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/washturn

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to Firebase service account JSON, or leave unset to disable push notifications locally
FIREBASE_SERVICE_ACCOUNT_PATH=

# Default IANA timezone used for new households
DEFAULT_HOUSEHOLD_TIMEZONE=UTC

# Comma-separated browser origins allowed to call the API cross-origin (e.g.
# https://app.example.com,https://admin.example.com). Irrelevant to the
# Flutter app. Required only if a browser-based client will ever call this
# API in production; leave unset otherwise.
CORS_ORIGIN=
