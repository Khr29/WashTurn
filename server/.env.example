# PORT: leave unset in production — Render (and most PaaS) inject this
# automatically. Only needed locally, where it defaults to 4000 anyway.
PORT=4000
# development locally; the production host's dashboard should set this to
# "production" instead (enables trust-proxy, strict CORS allow-listing, and
# disallows a short/default JWT_SECRET — see src/config/env.js).
NODE_ENV=development

# Local dev: a MongoDB instance on your own machine.
# Production: a MongoDB Atlas connection string (mongodb+srv://...) — never
# committed here, set directly in the hosting platform's dashboard.
MONGO_URI=mongodb://localhost:27017/washturn

# Production requires at least 32 random characters (enforced at startup —
# see src/config/env.js). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to Firebase service account JSON, or leave unset to disable push notifications locally
FIREBASE_SERVICE_ACCOUNT_PATH=

# Default IANA timezone used for new households
DEFAULT_HOUSEHOLD_TIMEZONE=UTC

# Comma-separated browser origins allowed to call the API cross-origin (e.g.
# https://app.example.com,https://admin.example.com). Irrelevant to the
# Flutter app. Required only if a browser-based client will ever call this
# API in production; leave unset otherwise.
CORS_ORIGIN=
